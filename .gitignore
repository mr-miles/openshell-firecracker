# Cargo build output. Cargo.lock is kept: the launcher is a binary.
/target

# Release staging (release.yml builds these in CI; a local run may leave them).
/dist
/assets
# The OpenShell checkout that `mise run interim:runtime` stages the driver's runtime from.
/openshell

# Real configuration and secrets. Only the examples are tracked.
*.env
!/examples/*.env
*.pem
*.key

# Files install.sh writes beside ones you have edited.
*.new

# Guest kernel build output and local VM state.
/linux-*
vmlinux
*.ext4
*.log

# Editors and OS.
*~
*.swp
*.swo
.idea/
.vscode/
.DS_Store
