# Install as ~/.config/openshell/firecracker-driver.env (mode 0600).
# Values are examples; replace them for your host. systemd does not expand
# specifiers such as %h in this file, so write absolute paths.

# --- VM driver -------------------------------------------------------------

# Required: where the host supervisor reaches the gateway.
OPENSHELL_GRPC_ENDPOINT=https://127.0.0.1:17670
# Required for an https:// endpoint: the gateway CA certificate (ca.crt, not ca.pem).
OPENSHELL_VM_TLS_CA=/home/USER/.local/state/openshell/tls/ca.crt
OPENSHELL_VM_DRIVER_STATE_DIR=/home/USER/.local/state/openshell/firecracker-driver

# At least one image must be set.
OPENSHELL_SANDBOX_IMAGE=nvcr.io/nvidia/base/ubuntu:24.04

# Optional: the working directory for a sandbox whose image sets no WORKDIR (it never
# overrides an image's; an image WORKDIR elsewhere gets this path as a symlink to it).
# OPENSHELL_VM_DEFAULT_WORKDIR=/sandbox

# Must match the gateway's [openshell.drivers.firecracker] admission settings, or the
# gateway refuses the driver. {} is the default on both sides: no caller driver_config.
# To let sandboxes set driver_config (disk size, files), set allow_driver_config = true in
# the gateway table too, and use (single quotes kept, so systemd leaves the JSON intact):
# OPENSHELL_DRIVER_ADMISSION_CONFIG_JSON='{"allow_driver_config": true}'
OPENSHELL_DRIVER_ADMISSION_CONFIG_JSON={}

# --- Firecracker plugin ----------------------------------------------------

# Required: the launcher the driver runs for every VM, and for image preparation.
OPENSHELL_VM_LAUNCHER_BIN=/usr/local/libexec/openshell-firecracker/openshell-firecracker-launcher

# Optional. Without these the launcher looks for firecracker beside itself, on PATH and
# in /usr/local/bin, /usr/bin and /opt/firecracker, and for vmlinux beside itself
# (where install.sh puts the pre-built kernel). Set them to use other files.
# OPENSHELL_VM_FIRECRACKER_BIN=/opt/firecracker/firecracker
# OPENSHELL_VM_FIRECRACKER_KERNEL=/var/lib/openshell-firecracker/vmlinux

# Run each VMM as its own subordinate uid: auto (default), required, or off.
# Needs /etc/subuid and /etc/subgid ranges, uidmap, and a world-accessible /dev/kvm;
# auto falls back to the driver's user with a warning when they are missing.
# OPENSHELL_VM_FIRECRACKER_SUBUIDS=auto

# Firecracker's own log level, written to each sandbox's rootfs-console.log:
# off, error, warn (default), info, debug or trace.
# OPENSHELL_VM_FIRECRACKER_LOG_LEVEL=warn

# Compressed swap (zram) in each guest, as a percentage of its memory: 0 to 200,
# 0 for none. For more memory, raise OPENSHELL_VM_DRIVER_MEM_MIB (default 2048), or set
# OPENSHELL_VM_MAX_MEM_MIB below and request driver_config.mem_mib per sandbox.
# OPENSHELL_VM_FIRECRACKER_ZRAM_PERCENT=50

# --- Supervisor identity (optional) ------------------------------------------

# Issue SPIFFE JWT-SVIDs to host supervisors over a per-sandbox Workload API socket,
# and serve the JWKS that verifies them. Off by default. See "Supervisor identity"
# in the README.
# OPENSHELL_VM_SUPERVISOR_IDENTITY=true
# OPENSHELL_VM_SUPERVISOR_IDENTITY_TRUST_DOMAIN=openshell.local
# OPENSHELL_VM_SUPERVISOR_IDENTITY_JWKS_BIND=127.0.0.1:8961
# The URL relying parties fetch the JWKS from; defaults to http://<JWKS bind>.
# OPENSHELL_VM_SUPERVISOR_IDENTITY_ISSUER=https://openshell-identity.example.com
# OPENSHELL_VM_SUPERVISOR_IDENTITY_SVID_TTL_SECS=300

# --- Per-sandbox memory, disk size and files (optional) -----------------------

# Limits for what a sandbox may request in its driver_config. See "Per-sandbox memory,
# disk size and files" in the README. Sandboxes can request these only when allow_driver_config is
# on (OPENSHELL_DRIVER_ADMISSION_CONFIG_JSON above, and the gateway table).
# Largest overlay_disk_mib a sandbox may ask for (the default size is
# OPENSHELL_VM_OVERLAY_DISK_MIB, 4096).
# OPENSHELL_VM_MAX_OVERLAY_DISK_MIB=65536
# Largest mem_mib a sandbox may ask for. Unset: no more than the default memory,
# OPENSHELL_VM_DRIVER_MEM_MIB (2048).
# OPENSHELL_VM_MAX_MEM_MIB=8192
# Host directory that driver_config.files sources are read from. Unset: no files.
# OPENSHELL_VM_FILES_ROOT=/home/USER/.local/share/openshell/sandbox-files
# Total bytes of files one sandbox may provision.
# OPENSHELL_VM_FILES_MAX_BYTES=268435456

# --- Image cache cleanup (optional) -----------------------------------------

# Prepared disks under $OPENSHELL_VM_DRIVER_STATE_DIR/images that no sandbox references
# are removed this many hours after their last use; disks from other driver builds go
# at once. A sandbox's image is kept while the sandbox exists, running or stopped.
# 0 keeps every disk. See "Image cache cleanup" in the README.
# OPENSHELL_VM_IMAGE_CACHE_MAX_IDLE_HOURS=48

# --- Image sources (optional) -----------------------------------------------

# An image name with a registry host (192.168.1.239:5000/app, ghcr.io/org/app) always
# comes from that registry. A name without one (app:latest, localhost/app) comes only
# from the local container engine chosen here: auto (Docker's socket, then Podman's),
# docker, podman, or off (every name needs a registry host). See "Image sources" in
# the README.
# OPENSHELL_VM_LOCAL_IMAGE_SOURCE=auto
# Replaces the mode's default socket (a path or unix:// URL). Not allowed with off.
# OPENSHELL_VM_LOCAL_IMAGE_SOURCE_SOCKET=/run/user/1000/podman/podman.sock
