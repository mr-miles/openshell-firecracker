# The OpenShell revision the vendored driver (vendor/openshell) was taken from. The driver's
# git dependencies on the other OpenShell crates use the same revision: the `rev` in
# vendor/openshell/Cargo.toml must equal this (`mise run driver:check-pin`).
#
# The host supervisor and guest sandbox binaries the driver embeds are built from this
# same revision, and the gateway must be built from a compatible one: the supervisor
# protocol is not stable across revisions. To move to another revision, re-vendor the
# driver crate from it (see crates/openshell-driver-vm/README.md), then change the commit here
# and the `rev` in vendor/openshell/Cargo.toml.
OPENSHELL_REPO=https://github.com/NVIDIA/OpenShell
OPENSHELL_COMMIT=f3d976590d3eb1379690a2abaf0f0e26c21d487d
OPENSHELL_TAG=v0.1.8

# Optional: build the embedded runtime (host supervisor, guest sandbox, guest init) from
# another revision than the pin above, to try an OpenShell change against an unchanged
# driver. The vendored driver crate and its git dependencies keep the pin, so run a
# gateway compatible with the pin. Unsupported: for testing, not for releases.
#
# TRIAL: the `patched` branch on the mr-miles fork: v0.1.8 with the backport of
# NVIDIA/OpenShell PR #5361 and the supervisor wait recovery-window fix
# (fix/wait-recovery-window-reset). Not for merging. The branch carries no release tag,
# so the binaries report a development version.
OPENSHELL_RUNTIME_REPO=https://github.com/mr-miles/OpenShell
OPENSHELL_RUNTIME_COMMIT=07d7e98bdcf8b5a0df2be91ca5526c0d2340f15d
OPENSHELL_RUNTIME_TAG=

# The guest unpacks OCI images with umoci. Same pin as OpenShell's runtime/pins.env.
UMOCI_VERSION=v0.6.0
